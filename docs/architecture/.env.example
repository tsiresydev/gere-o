# Configuration locale (ne pas committer)
# Copier ce fichier en `.env` et l'ajouter à `.gitignore`.

# Backend — NestJS
PORT=3000
NODE_ENV=development

# Base de données — MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Authentification — JWT
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# CORS (origines autorisées, séparées par des virgules)
CORS_ORIGIN=http://localhost:3001

# Email — Gmail SMTP (mot de passe d'application)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tsiresy.madasoftware@gmail.com
SMTP_PASSWORD=<mot de passe d'application Google>
SMTP_FROM=tsiresy.madasoftware@gmail.com
EMAIL_REPORT_BCC=tsiresyrabekoto@gmail.com
